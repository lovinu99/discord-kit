{
  "name": "@lovinu264/discord-kit",
  "version": "0.2.3",
  "description": "Tiny TypeScript notifications for Discord webhooks — with native media uploads, rich embeds, and Components V2 support",
  "keywords": [
    "discord",
    "discord-webhook",
    "notifications",
    "typescript",
    "webhook",
    "developer-tools",
    "components-v2",
    "rich-embeds",
    "media-upload"
  ],
  "author": "danh264",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovinu99/discord-kit.git"
  },
  "homepage": "https://github.com/lovinu99/discord-kit#readme",
  "bugs": {
    "url": "https://github.com/lovinu99/discord-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:package": "node scripts/verify-package.mjs",
    "prepack": "npm run check:secrets && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run prepack"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
